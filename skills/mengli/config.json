{
  "baseBranch": "master",
  "defaults": { "model": null, "effort": null },
  "agents": {
    "planner": {},
    "plan-reviewer": {},
    "code-reviewer": {},
    "qa": {},
    "mr-reviewer": {}
  },
  "qa": {
    "platform": "ios",
    "env": "staging",
    "buildType": "release",
    "ios": {
      "workspace": "ios/FlipApp.xcworkspace",
      "scheme": "FlipAppStaging",
      "configuration": "Staging",
      "productDir": "Staging-iphonesimulator",
      "appName": "Flip.app",
      "appId": "id.flip.staging",
      "device": null
    },
    "android": {
      "buildScript": "build_android_staging_release",
      "apkDir": "android/app/build/outputs/apk/staging/release",
      "appId": "id.flip.staging",
      "avd": null
    },
    "maxAttempts": 5,
    "maxHeals": 2
  },
  "limits": { "planReviewRounds": 2, "checkFixRounds": 3 }
}
