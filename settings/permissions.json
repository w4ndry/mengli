{
  "allow": [
    "Bash(git *)",
    "Bash(glab *)",
    "Bash(npx tsc --noEmit*)",
    "Bash(maestro *)",
    "Bash(kill -INT *)",
    "Bash(mkdir *)",
    "Bash(python3 ~/.claude/skills/mengli/scripts/*)",
    "Bash(python3 {{HOME}}/.claude/skills/mengli/scripts/*)",
    "Bash(~/.claude/skills/mengli/scripts/*)",
    "Bash({{HOME}}/.claude/skills/mengli/scripts/*)",
    "mcp__clickup__clickup_get_task",
    "mcp__clickup__clickup_update_task",
    "mcp__clickup__clickup_get_list",
    "Edit(/{{HOME}}/.claude/mengli/**)",
    "Write(/{{HOME}}/.claude/mengli/**)"
  ],
  "deny": [
    "Bash(glab mr merge*)",
    "Bash(glab mr approve*)",
    "Bash(glab mr close*)",
    "Bash(git push --force*)",
    "Bash(git push -f*)",
    "Bash(git push * --force*)",
    "Bash(git push * -f*)",
    "Bash(git push origin master*)",
    "Bash(git push origin develop*)",
    "Bash(git push origin release/*)",
    "Bash(git reset --hard*)",
    "Bash(git clean*)",
    "Bash(gh pr merge*)",
    "Bash(gh pr close*)",
    "Bash(gh pr review * --approve*)",
    "Bash(git push origin main*)"
  ]
}
